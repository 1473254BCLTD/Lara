{
  "name": "@lara/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file=../../infra/.env.migration ./scripts/migrate.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@lara/typescript-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  }
}
