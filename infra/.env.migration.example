# PostgreSQL migration connection
#
# Used exclusively by Drizzle migrations.
# Never use these credentials in the API or worker.
#
# Copy this file to infra/.env.migration and replace
# the password with a cryptographically secure value.

MIGRATION_DATABASE_HOST=127.0.0.1
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_NAME=lara_dev
MIGRATION_DATABASE_USER=lara_migrator
MIGRATION_DATABASE_PASSWORD=replace-with-secure-password